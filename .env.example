# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careeraccess?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# WhatsApp (Baileys)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH="./whatsapp-sessions"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Platform
PLATFORM_NAME="CareerAccess Zimbabwe"
PLATFORM_URL="http://localhost:3001"
CURRENCY="USD"
